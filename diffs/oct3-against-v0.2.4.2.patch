diff --git a/src/kernels/kv_exact_window_parity.cpp b/src/kernels/kv_exact_window_parity.cpp
new file mode 100644
index 00000000..f362bd67
--- /dev/null
+++ b/src/kernels/kv_exact_window_parity.cpp
@@ -0,0 +1,155 @@
+// src/kernels/kv_exact_window_parity.cpp - the exact KV window (GPU, synthetic, no model): the sinks stay, the ring
+// evicts in position order, a gather reports hits and misses correctly, and the values come back exactly (the
+// pattern is integer-valued, so fp16 is lossless here and any difference is a bug).
+#include "strata/kernels/kv_exact_window.hpp"
+#include "strata/kernels/kv_stream.hpp"
+#include "strata/kernels/f16_bits.hpp"
+
+#include <cuda_runtime.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+namespace K = strata::kernels;
+
+namespace {
+void ck(cudaError_t e, const char* what) {
+    if (e != cudaSuccess) {
+        std::fprintf(stderr, "%s: %s\n", what, cudaGetErrorString(e));
+        std::exit(1);
+    }
+}
+float pat(int pos, int h, int d) { return (float) (pos * 10 + h * 2 + (d & 1)); }
+}  // namespace
+
+int main() {
+    const K::QsaShapes s = K::qsa_real_shapes();
+    const int layers = 2, sinks = 4, tail = 8, stride = 4;
+    const int heads = (int) s.n_head_kv, hd = (int) s.head_dim;
+    K::KvExactWindow w;
+    w.layers = layers; w.sinks = sinks; w.tail = tail; w.n_head_kv = heads; w.head_dim = hd; w.pos_stride = stride;
+    const size_t rows = (size_t) layers * (sinks + tail);
+    const size_t row_vals = (size_t) heads * hd;
+    ck(cudaMalloc(&w.k, rows * row_vals * 2), "malloc k");
+    ck(cudaMalloc(&w.v, rows * row_vals * 2), "malloc v");
+    ck(cudaMalloc(&w.tag, rows * sizeof(int32_t)), "malloc tag");
+    K::kv_exact_window_init(w, s, layers, sinks, tail, stride, nullptr);
+
+    // append positions 0..19 one cell at a time, layer 0 only (layer 1 stays empty on purpose)
+    const int n_pos = 20;
+    int32_t* d_step = nullptr;
+    float* d_k = nullptr;
+    float* d_v = nullptr;
+    ck(cudaMalloc(&d_step, stride * sizeof(int32_t)), "malloc step");
+    ck(cudaMalloc(&d_k, row_vals * sizeof(float)), "malloc kcur");
+    ck(cudaMalloc(&d_v, row_vals * sizeof(float)), "malloc vcur");
+    std::vector<float> hkv(row_vals);
+    for (int pos = 0; pos < n_pos; ++pos) {
+        std::vector<int32_t> hstep(stride, -7);
+        hstep[K::kStepPos] = pos;
+        for (int h = 0; h < heads; ++h)
+            for (int d = 0; d < hd; ++d) hkv[(size_t) h * hd + d] = pat(pos, h, d);
+        ck(cudaMemcpy(d_step, hstep.data(), stride * sizeof(int32_t), cudaMemcpyHostToDevice), "step");
+        ck(cudaMemcpy(d_k, hkv.data(), row_vals * sizeof(float), cudaMemcpyHostToDevice), "k");
+        ck(cudaMemcpy(d_v, hkv.data(), row_vals * sizeof(float), cudaMemcpyHostToDevice), "v");
+        K::kv_exact_window_append(w, 0, d_step, d_k, d_v, 1, nullptr);
+    }
+    ck(cudaDeviceSynchronize(), "after appends");
+
+    // gather: sinks (0..3), the newest eight (12..19) and two that must miss (11, 99)
+    const int want[] = {0, 1, 2, 3, 12, 13, 14, 15, 16, 17, 18, 19, 11, 99};
+    const int n = (int) (sizeof(want) / sizeof(want[0]));
+    int32_t* d_pos = nullptr;
+    int32_t* d_hit = nullptr;
+    uint16_t* d_ko = nullptr;
+    uint16_t* d_vo = nullptr;
+    ck(cudaMalloc(&d_pos, n * sizeof(int32_t)), "malloc pos");
+    ck(cudaMalloc(&d_hit, n * sizeof(int32_t)), "malloc hit");
+    ck(cudaMalloc(&d_ko, (size_t) n * row_vals * 2), "malloc ko");
+    ck(cudaMalloc(&d_vo, (size_t) n * row_vals * 2), "malloc vo");
+    ck(cudaMemcpy(d_pos, want, n * sizeof(int32_t), cudaMemcpyHostToDevice), "pos");
+    K::kv_exact_window_gather(w, 0, d_pos, n, d_ko, d_vo, d_hit, nullptr);
+    ck(cudaDeviceSynchronize(), "after gather");
+
+    std::vector<int32_t> hit(n);
+    std::vector<uint16_t> ko((size_t) n * row_vals), vo((size_t) n * row_vals);
+    ck(cudaMemcpy(hit.data(), d_hit, n * sizeof(int32_t), cudaMemcpyDeviceToHost), "hit");
+    ck(cudaMemcpy(ko.data(), d_ko, ko.size() * 2, cudaMemcpyDeviceToHost), "ko");
+    ck(cudaMemcpy(vo.data(), d_vo, vo.size() * 2, cudaMemcpyDeviceToHost), "vo");
+
+    int bad = 0;
+    std::printf("pos  expect  hit  values\n");
+    for (int i = 0; i < n; ++i) {
+        const bool expect = want[i] < sinks || (want[i] >= n_pos - tail && want[i] < n_pos);
+        int vbad = 0;
+        if (hit[i]) {
+            for (int h = 0; h < heads; ++h)
+                for (int d = 0; d < hd; ++d) {
+                    const uint16_t want_bits = K::f16_from_f32(pat(want[i], h, d));
+                    if (ko[(size_t) i * row_vals + (size_t) h * hd + d] != want_bits) ++vbad;
+                    if (vo[(size_t) i * row_vals + (size_t) h * hd + d] != want_bits) ++vbad;
+                }
+        }
+        const bool ok = (hit[i] != 0) == expect && vbad == 0;
+        if (!ok) ++bad;
+        std::printf("%3d  %-6s  %-3s  %s\n", want[i], expect ? "hit" : "miss", hit[i] ? "hit" : "miss",
+                    vbad ? "WRONG VALUES" : (ok ? "ok" : "unexpected"));
+    }
+
+    // ---- the prompt path: one contiguous block, positions 0..19 in one call, `end` = 20.  Only the sinks and the
+    // last `tail` cells may land; everything in between can never be in the finished prompt's window.
+    K::KvExactWindow w2;
+    w2.layers = 1; w2.sinks = sinks; w2.tail = tail; w2.n_head_kv = heads; w2.head_dim = hd; w2.pos_stride = stride;
+    ck(cudaMalloc(&w2.k, rows * row_vals * 2), "malloc k2");
+    ck(cudaMalloc(&w2.v, rows * row_vals * 2), "malloc v2");
+    ck(cudaMalloc(&w2.tag, rows * sizeof(int32_t)), "malloc tag2");
+    K::kv_exact_window_init(w2, s, 1, sinks, tail, stride, nullptr);
+    {
+        std::vector<float> blk((size_t) n_pos * row_vals);
+        for (int pos = 0; pos < n_pos; ++pos)
+            for (int h = 0; h < heads; ++h)
+                for (int d = 0; d < hd; ++d) blk[(size_t) pos * row_vals + (size_t) h * hd + d] = pat(pos, h, d);
+        float* d_kb = nullptr;
+        float* d_vb = nullptr;
+        ck(cudaMalloc(&d_kb, blk.size() * 4), "malloc range k");
+        ck(cudaMalloc(&d_vb, blk.size() * 4), "malloc range v");
+        ck(cudaMemcpy(d_kb, blk.data(), blk.size() * 4, cudaMemcpyHostToDevice), "range k");
+        ck(cudaMemcpy(d_vb, blk.data(), blk.size() * 4, cudaMemcpyHostToDevice), "range v");
+        K::kv_exact_window_append_range(w2, 0, 0, n_pos, d_kb, d_vb, n_pos, nullptr);
+        ck(cudaDeviceSynchronize(), "after range append");
+        std::vector<int32_t> all(n_pos);
+        for (int i = 0; i < n_pos; ++i) all[(size_t) i] = i;
+        int32_t* d_all = nullptr;
+        uint16_t* d_ko2 = nullptr;
+        uint16_t* d_vo2 = nullptr;
+        ck(cudaMalloc(&d_all, n_pos * 4), "malloc all");
+        ck(cudaMalloc(&d_ko2, (size_t) n_pos * row_vals * 2), "malloc ko2");
+        ck(cudaMalloc(&d_vo2, (size_t) n_pos * row_vals * 2), "malloc vo2");
+        ck(cudaMemcpy(d_all, all.data(), n_pos * 4, cudaMemcpyHostToDevice), "all");
+        // hit = null: the "gather after the quantized pool" form the engine uses
+        K::kv_exact_window_gather(w2, 0, d_all, n_pos, d_ko2, d_vo2, nullptr, nullptr);
+        ck(cudaDeviceSynchronize(), "after range gather");
+        std::vector<uint16_t> ko2((size_t) n_pos * row_vals);
+        ck(cudaMemcpy(ko2.data(), d_ko2, ko2.size() * 2, cudaMemcpyDeviceToHost), "ko2");
+        int rbad = 0;
+        for (int pos = 0; pos < n_pos; ++pos) {
+            const bool expect = pos < sinks || pos >= n_pos - tail;
+            int vbad = 0;
+            if (expect)
+                for (int h = 0; h < heads; ++h)
+                    for (int d = 0; d < hd; ++d)
+                        if (ko2[(size_t) pos * row_vals + (size_t) h * hd + d] != K::f16_from_f32(pat(pos, h, d))) ++vbad;
+            if (vbad) ++rbad;
+        }
+        std::printf("\nprompt range 0..%d with end=%d: sinks and the last %d cells written, the rest skipped: %s\n",
+                    n_pos - 1, n_pos, tail, rbad ? "WRONG" : "ok");
+        if (rbad) ++bad;
+    }
+
+    const double per_layer = (double) K::kv_exact_window_bytes_per_layer(s, 4, 64);
+    std::printf("\nwindow cost at the real geometry (sinks 4 + tail 64, one layer): %.2f MiB, x12 layers %.1f MiB\n",
+                per_layer / (1024 * 1024), 12 * per_layer / (1024 * 1024));
+    std::printf("%s\n", bad ? "FAIL" : "ok: sinks kept, ring evicts in order, values exact");
+    return bad ? 1 : 0;
+}
diff --git a/src/kernels/kv_octave_parity.cpp b/src/kernels/kv_octave_parity.cpp
new file mode 100644
index 00000000..22a3afd5
--- /dev/null
+++ b/src/kernels/kv_octave_parity.cpp
@@ -0,0 +1,218 @@
+// src/kernels/kv_octave_parity.cpp - the 3-bit Lloyd-Max KV format against a host reference (GPU, synthetic,
+// no model): the device bytes must equal the host reference bit for bit, and the error it leaves on rotated
+// vectors is reported next to a 4-bit uniform grid's on the same data.
+#include "strata/kernels/kv_octave.hpp"
+#include "strata/kernels/kv_q4.hpp"
+#include "strata/kernels/kv_stream.hpp"   // KvHostPools
+#include "strata/kernels/f16_bits.hpp"
+
+#include <cuda_runtime.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <vector>
+
+namespace K = strata::kernels;
+
+namespace {
+void ck(cudaError_t e, const char* what) {
+    if (e != cudaSuccess) {
+        std::fprintf(stderr, "%s: %s\n", what, cudaGetErrorString(e));
+        std::exit(1);
+    }
+}
+
+void rel_err(const char* label, const std::vector<float>& a, const std::vector<float>& b, double* mse_out) {
+    double se = 0, sx = 0;
+    for (size_t i = 0; i < a.size(); ++i) {
+        const double d = (double) a[i] - (double) b[i];
+        se += d * d;
+        sx += (double) a[i] * (double) a[i];
+    }
+    const double mse = se / (double) a.size();
+    if (mse_out) *mse_out = mse;
+    std::printf("  %-22s MSE/coord %.6f   rel L2 %.5f\n", label, mse, std::sqrt(se / std::max(1e-30, sx)));
+}
+
+// A 4-bit uniform grid on the same rotated vectors: per-32 amax, q4_0's d = amax/-8 (the codebook q4_0 ships).
+void q4_uniform_ref(const std::vector<float>& x, std::vector<float>& out) {
+    out.assign(x.size(), 0.0f);
+    for (size_t g = 0; g < x.size() / 32; ++g) {
+        const float* p = &x[g * 32];
+        float amax = 0.0f, mval = 0.0f;
+        for (int i = 0; i < 32; ++i)
+            if (std::fabs(p[i]) > amax || (std::fabs(p[i]) == amax && p[i] > mval)) { amax = std::fabs(p[i]); mval = p[i]; }
+        const float d = mval / -8.0f;
+        const float id = d != 0.0f ? 1.0f / d : 0.0f;
+        for (int i = 0; i < 32; ++i) {
+            int q = (int) std::trunc(p[i] * id + 8.5f);
+            q = q < 0 ? 0 : (q > 15 ? 15 : q);
+            out[g * 32 + i] = (float) (q - 8) * d;
+        }
+    }
+}
+}  // namespace
+
+int main() {
+    const int groups = 4096;                       // 131,072 values
+    const size_t n = (size_t) groups * K::QK_OCT;
+    std::mt19937 rng(7);
+    std::normal_distribution<float> gauss(0.0f, 1.0f);
+    std::vector<float> x(n);
+    for (auto& v : x) v = gauss(rng);
+    for (size_t i = 0; i < n; i += 97) x[i] *= 8.0f;   // KV-like outliers
+    std::vector<float> rot(n);
+
+    float* d_x = nullptr;
+    float* d_rot = nullptr;
+    float* d_back = nullptr;
+    float* d_dec = nullptr;
+    uint8_t* d_enc = nullptr;
+    const size_t enc_bytes = (size_t) groups * sizeof(K::block_oct3);
+    ck(cudaMalloc(&d_x, n * 4), "malloc x");
+    ck(cudaMalloc(&d_rot, n * 4), "malloc rot");
+    ck(cudaMalloc(&d_back, n * 4), "malloc back");
+    ck(cudaMalloc(&d_dec, n * 4), "malloc dec");
+    ck(cudaMalloc(&d_enc, enc_bytes), "malloc enc");
+    ck(cudaMemcpy(d_x, x.data(), n * 4, cudaMemcpyHostToDevice), "copy x");
+
+    // ---- 1. device vs host reference, byte for byte -------------------------------------------------
+    K::kv_oct_quantize(d_x, d_enc, groups, nullptr);
+    std::vector<uint8_t> enc(enc_bytes);
+    ck(cudaMemcpy(enc.data(), d_enc, enc_bytes, cudaMemcpyDeviceToHost), "copy enc");
+    int enc_mismatch = 0, dec_mismatch = 0;
+    K::kv_oct_dequantize(d_enc, d_dec, groups, nullptr);
+    std::vector<float> dec(n);
+    ck(cudaMemcpy(dec.data(), d_dec, n * 4, cudaMemcpyDeviceToHost), "copy dec");
+    for (int gi = 0; gi < groups; ++gi) {
+        K::block_oct3 ref{};
+        K::kv_oct_quantize_group_host(&x[(size_t) gi * K::QK_OCT], ref);
+        if (std::memcmp(&ref, &enc[(size_t) gi * sizeof(K::block_oct3)], sizeof(ref)) != 0) ++enc_mismatch;
+        float href[K::QK_OCT];
+        K::kv_oct_dequantize_group_host(ref, href);
+        for (int i = 0; i < K::QK_OCT; ++i)
+            if (std::memcmp(&href[i], &dec[(size_t) gi * K::QK_OCT + i], sizeof(float)) != 0) ++dec_mismatch;
+    }
+    std::printf("host reference: %d/%d groups differ in the packed bytes, %d/%zu dequantized values differ\n",
+                enc_mismatch, groups, dec_mismatch, n);
+
+    // ---- 2. the error on the vectors themselves (unrotated domain) ----------------------------------
+    double mse_oct = 0, mse_q4 = 0;
+    std::vector<float> q4;
+    q4_uniform_ref(x, q4);
+    std::printf("\nunrotated data (MSE is what the format costs, before rotation helps):\n");
+    rel_err("oct3 (3-bit, Lloyd-Max)", x, dec, &mse_oct);
+    rel_err("q4_0 (4-bit, uniform)", x, q4, &mse_q4);
+
+    // ---- 3. what the KV path actually stores: rotate first ------------------------------------------
+    K::fwht256_cuda(d_x, d_rot, (int64_t) (n / 256), nullptr);   // rows of 256 = one head
+    K::kv_oct_quantize(d_rot, d_enc, groups, nullptr);
+    K::kv_oct_dequantize(d_enc, d_dec, groups, nullptr);
+    std::vector<float> rot_host(n), rot_dec(n);
+    ck(cudaMemcpy(rot_host.data(), d_rot, n * 4, cudaMemcpyDeviceToHost), "copy rot");
+    ck(cudaMemcpy(rot_dec.data(), d_dec, n * 4, cudaMemcpyDeviceToHost), "copy rot dec");
+    K::fwht256_cuda(d_dec, d_back, (int64_t) (n / 256), nullptr);   // H is its own inverse
+    std::vector<float> back(n);
+    ck(cudaMemcpy(back.data(), d_back, n * 4, cudaMemcpyDeviceToHost), "copy back");
+
+    std::vector<float> rot4;
+    q4_uniform_ref(rot_host, rot4);
+    std::printf("\nrotated domain (the frame K and V are stored in):\n");
+    double mse_rot = 0, mse_rot4 = 0, mse_trip = 0;
+    rel_err("oct3 (3-bit, Lloyd-Max)", rot_host, rot_dec, &mse_rot);
+    rel_err("q4_0 (4-bit, uniform)", rot_host, rot4, &mse_rot4);
+    std::printf("  oct3 is %.2fx the 4-bit MSE at %.0f%% of its bytes\n", mse_rot / std::max(1e-30, mse_rot4),
+                100.0 * 112.0 / 144.0);
+    rel_err("oct3 full round trip", x, back, &mse_trip);
+
+    // ---- 4. what it costs in bytes ------------------------------------------------------------------
+    const K::QsaShapes s = K::qsa_real_shapes();
+    const uint64_t oct_head = K::kv_oct_bytes_per_head((int) s.head_dim);
+    std::printf("\nbytes: %llu per head per K or V (%d values), %llu per cell (K+V, both KV heads)\n",
+                (unsigned long long) oct_head, (int) s.head_dim, (unsigned long long) K::kv_oct_bytes_per_cell(s));
+    std::printf("       q4_0 144/576, k8v4 528/816, int8 528/1056 -> oct3 is %.0f%% of k8v4's cell\n",
+                100.0 * (double) K::kv_oct_bytes_per_cell(s) / 816.0);
+
+    // ---- 5. engine-shaped storage: page table + host copy, then gather by ids ------------------------
+    int oct_bad = 0;
+    {
+        const int pages = 4, page_size = (int) s.page_size, cells = pages * page_size;
+        const int rows = cells * (int) s.n_head_kv;
+        const int bph = (int) (s.head_dim / K::QK_OCT);
+        const size_t vals = (size_t) rows * s.head_dim;
+        const size_t pool_bytes = (size_t) rows * bph * sizeof(K::block_oct3);
+        std::vector<float> src(vals);
+        for (auto& v : src) v = gauss(rng);
+        float *d_src = nullptr, *d_rot = nullptr, *d_rotv = nullptr;
+        ck(cudaMalloc(&d_src, vals * 4), "m src");
+        ck(cudaMalloc(&d_rot, vals * 4), "m rot");
+        ck(cudaMalloc(&d_rotv, vals * 4), "m rotv");
+        ck(cudaMemcpy(d_src, src.data(), vals * 4, cudaMemcpyHostToDevice), "c");
+        K::fwht256_cuda(d_src, d_rot, (int64_t) rows, nullptr);
+        ck(cudaMemcpy(d_rotv, d_rot, vals * 4, cudaMemcpyDeviceToDevice), "c");
+        std::vector<float> rotv(vals);
+        ck(cudaMemcpy(rotv.data(), d_rot, vals * 4, cudaMemcpyDeviceToHost), "c");
+
+        std::vector<int32_t> tab(pages);
+        for (int pgi = 0; pgi < pages; ++pgi) tab[pgi] = pgi;      // every page resident in its own slot
+        int32_t* d_tab = nullptr;
+        ck(cudaMalloc(&d_tab, pages * 4), "m tab");
+        ck(cudaMemcpy(d_tab, tab.data(), pages * 4, cudaMemcpyHostToDevice), "c tab");
+        uint8_t *d_k = nullptr, *d_v = nullptr, *h_k = nullptr, *h_v = nullptr;
+        ck(cudaMalloc(&d_k, pool_bytes), "m k");
+        ck(cudaMalloc(&d_v, pool_bytes), "m v");
+        ck(cudaMalloc(&h_k, pool_bytes), "m hk");
+        ck(cudaMalloc(&h_v, pool_bytes), "m hv");
+        K::KvHostPools hostp{};
+        hostp.k_q4 = h_k;
+        hostp.v_q4 = h_v;
+        K::kv_append_oct(d_k, d_v, d_tab, 0, cells, d_rot, d_rotv, s, nullptr, &hostp, nullptr);
+        ck(cudaDeviceSynchronize(), "append");
+
+        const int ids[4] = {0, 5, 9, cells - 1};
+        int32_t* d_ids = nullptr;
+        ck(cudaMalloc(&d_ids, sizeof(ids)), "m ids");
+        ck(cudaMemcpy(d_ids, ids, sizeof(ids), cudaMemcpyHostToDevice), "c ids");
+        std::vector<int32_t> step(4, 0);
+        step[K::kStepWidth] = 4;
+        int32_t* d_step = nullptr;
+        ck(cudaMalloc(&d_step, 16), "m step");
+        ck(cudaMemcpy(d_step, step.data(), 16, cudaMemcpyHostToDevice), "c step");
+        const size_t scr = (size_t) 4 * s.n_head_kv * s.head_dim;
+        uint16_t *d_ks = nullptr, *d_vs = nullptr;
+        ck(cudaMalloc(&d_ks, scr * 2), "m ks");
+        ck(cudaMalloc(&d_vs, scr * 2), "m vs");
+        K::kv_gather_oct_step(d_k, d_v, d_tab, d_ids, d_step, 4, s, d_ks, d_vs, nullptr);
+        ck(cudaDeviceSynchronize(), "gather");
+        std::vector<uint16_t> ks(scr), vs(scr);
+        ck(cudaMemcpy(ks.data(), d_ks, scr * 2, cudaMemcpyDeviceToHost), "c ks");
+        ck(cudaMemcpy(vs.data(), d_vs, scr * 2, cudaMemcpyDeviceToHost), "c vs");
+
+        for (int i = 0; i < 4; ++i)
+            for (int h = 0; h < (int) s.n_head_kv; ++h)
