# The fork's upstream switches, gfx1100 (RX 7900 XTX) - DEPLOYED on 2026-10-30.
#
# These are upstream v0.2.8 code - upstream's src/core/arch_defaults.cpp turns them on for gfx1151 and gfx12 only - and
# nicejunjie/Strata-rdna3 runs with them on gfx1100. Measured on this box, oct3, production config, engine 0.1.54,
# 4 reps (perf/raw/perf-fa54-*.jsonl):
#
#   base                        32K 1864 tok/s   96K 1787
#   ten switches + ring         32K 2108         96K 2008     (+13%)
#   + HIP_WMMA                  32K 2090         96K 1928     (nothing measurable; it does engage)
#   + GDN/PF_F16/AUTO_MAX/STAGER 32K 2243        96K 1979     (+20% over base at 32K)
#   + SELECT_WMMA               32K 2280         96K 2304
#   + PA_OCT (oct3 on the matrix cores)   32K 3443   96K 3513  (+50% over SELECT_WMMA; perf/raw/perf-paoct2.jsonl)
#     (the forum's 3.5K; --kv int8 with the same switches is 3516 / 3557 in the same session, perf/raw/perf-int8ref.jsonl)
#
# The 16-prompt decode harness on the deployed unit: 95.60 tok/s median, 0 stalls
# (perf/raw/tps2-prod-deployed.txt). STRATA_SPEC_CUM=0.4 is separate (docs/FORK-RDNA3-MAPPING.md §2a).
#
# Quality (perf/knob-quality.txt): bitwise identical on the stdin one-token path (4,995 positions); the batched prompt
# path keeps top-1 on all 20 prompts, mean KL 0.0138 (ten switches) and 0.0170 (full set) to the unswitched run
# (median 0.0005, max 0.125). For scale, oct3's own KV format is 0.0185 on the KV yardstick.
#
# One run WITH --stats stalled at the first prompt chunk and the watchdog aborted the engine after 60 s; it did not
# reproduce in four runs without --stats. Do not put --stats in the unit.

# prompt-path GEMM selection and fusion (these move the rounding)
STRATA_PF_FUSED=1
STRATA_PF_GEMM=1
STRATA_PF_PAD=1
STRATA_PF_HCDOWN=1
STRATA_PF_F16=2

# the prompt attention, the hyper-connection read, the head mix, the GDN recurrence, the QSA block scorer
STRATA_HIP_WMMA=1
STRATA_SELECT_WMMA=1
STRATA_PA_FAST=1
# the prompt attention reads the 3-bit codes (--kv oct3) on the matrix cores: docs/OCT3.md
STRATA_PA_OCT=1
STRATA_HC_UPMIX=1
STRATA_HEAD_MIX_MULTI=1
STRATA_GDN_CHUNKED=1
STRATA_GDN_HEAD=1
STRATA_GDN_CONVL2=1
STRATA_GDN_NOY=1
STRATA_GDN_PP=2

# the quantize, the verify window's dedup, the KV host staging
STRATA_QFUSE=1
STRATA_VERIFY_QDEDUP=1
STRATA_KV_HOST_DMA=1

# the prompt's staging ring, its chunk ceiling, and how it is split with the CPU experts
STRATA_PREFILL_RING=192
STRATA_PREFILL_AUTO_MAX=32768
STRATA_PREFILL_CPU_SHARE=auto
STRATA_PREFILL_CPU_SHARE_MAX=6144
STRATA_STAGER_RING=64
