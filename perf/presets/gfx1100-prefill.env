# The fork's upstream switches, gfx1100 (RX 7900 XTX), opt-in.
#
# They are upstream v0.2.8 code - upstream's src/core/arch_defaults.cpp turns them on for gfx1151 and gfx12 only - and
# nicejunjie/Strata-rdna3 runs with them on gfx1100. Measured on this box, oct3, production config, engine 0.1.54,
# 4 reps (perf/raw/perf-fa54-*.jsonl):
#
#   prefill 32K   1864 -> 2108 tok/s   (+13.1%)
#   prefill 96K   1787 -> 2008 tok/s   (+12.4%)
#   ms/forward    28.22/26.68 -> 25.33/26.11   (no consistent decode change)
#
# Quality (perf/knob-quality.txt): bitwise identical on the stdin one-token path (4,995 positions); the batched prompt
# path keeps top-1 on all 20 prompts with mean KL 0.0138 to the unswitched run (median 0.00026, max 0.134). For scale,
# oct3's own KV format is 0.0185 on the KV yardstick. One run of the whole set got no answer on its first prompt and
# did not reproduce - if that returns, bisect here first.
#
# Take it deliberately: source this file into the unit's Environment= or export it in the shell that starts the engine.

# prompt-path GEMM selection and fusion (these are what move the rounding)
STRATA_PF_FUSED=1
STRATA_PF_GEMM=1
STRATA_PF_PAD=1
STRATA_PF_HCDOWN=1

# the prompt attention, the hyper-connection read, the head mix
STRATA_PA_FAST=1
STRATA_HC_UPMIX=1
STRATA_HEAD_MIX_MULTI=1

# the quantize, the verify window's dedup, the KV host staging
STRATA_QFUSE=1
STRATA_VERIFY_QDEDUP=1
STRATA_KV_HOST_DMA=1

# the prompt's staging ring and how it is split with the CPU experts
STRATA_PREFILL_RING=192
STRATA_PREFILL_CPU_SHARE=auto
STRATA_PREFILL_CPU_SHARE_MAX=6144
